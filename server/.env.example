NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://velozity:velozity@localhost:5433/velozity?schema=public

JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# local development is same-site, so lax and insecure cookies are fine
CORS_ORIGIN=http://localhost:5173
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# a cross-site deployment (web and api on different domains) needs all four:
#   CORS_ORIGIN=https://your-web-domain
#   PUBLIC_API_URL=https://your-api-domain
#   COOKIE_SECURE=true
#   COOKIE_SAMESITE=none
# the api refuses to start on an invalid combination rather than losing
# sessions silently on the next page reload
# PUBLIC_API_URL=

OVERDUE_CRON=*/5 * * * *
SEED_ON_START=false
