# secrets used by docker compose, copy to .env before running the stack
JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string

# how often the overdue sweep runs, default */5 * * * * (every five minutes).
# set it to every minute while demonstrating it, so you do not have to wait.
# OVERDUE_CRON=* * * * *
